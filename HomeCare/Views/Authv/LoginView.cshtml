@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
    ViewData["HideLayout"] = true;
}

<div class="flex items-center justify-center min-h-screen px-6 bg-surface">
    <div class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-12 gap-0 overflow-hidden rounded-xl bg-surface-container-low shadow-[0_48px_100px_rgba(0,0,0,0.08)]">

        <!-- Left Visual Side -->
        <div class="hidden md:flex md:col-span-6 relative overflow-hidden group">
            <img alt="Luxury lifestyle"
                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                 src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=1000&auto=format&fit=crop" />
            <div class="absolute inset-0 bg-primary/30"></div>
            <div class="relative z-10 flex flex-col justify-end p-12 text-white h-full">
                <div class="uppercase tracking-widest text-[10px] font-medium mb-4 opacity-80">Collection 2024</div>
                <h1 class="font-headline text-5xl font-extrabold tracking-tighter leading-none mb-6">Elevate your digital presence.</h1>
                <p class="text-lg opacity-90 max-w-sm font-light leading-relaxed">Join a curated community of enthusiasts and creators shaping the future of retail.</p>
            </div>
        </div>

        <!-- Right Form Side -->
        <div class="md:col-span-6 bg-surface-container-lowest p-8 md:p-16 flex flex-col justify-center">
            <div class="max-w-md w-full mx-auto">
                <div class="mb-10">
                    <h2 class="font-headline text-3xl font-bold text-primary tracking-tight mb-2">Welcome Back</h2>
                    <p class="text-on-surface-variant text-sm">Please enter your details to access your curation.</p>
                </div>

                <form id="loginForm" class="space-y-6">
                    <div class="space-y-2">
                        <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="email">Email Address</label>
                        <div class="relative">
                            <input class="w-full px-4 py-3.5 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                                   id="email"
                                   name="email"
                                   type="email"
                                   placeholder="curator@example.com"
                                   required
                                   autocomplete="email" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="password">Password</label>
                            <a href="/Authv/ForgotPassword" class="text-xs font-semibold text-primary hover:opacity-80 transition-opacity">Forgot password?</a>
                        </div>
                        <div class="relative">
                            <input class="w-full px-4 py-3.5 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                                   id="password"
                                   name="password"
                                   type="password"
                                   placeholder="••••••••"
                                   required
                                   autocomplete="current-password" />
                            <button type="button" onclick="togglePassword('password', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                <span class="material-symbols-outlined text-lg">visibility_off</span>
                            </button>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <input class="w-5 h-5 rounded border-outline-variant text-primary focus:ring-primary-fixed cursor-pointer accent-primary"
                               id="remember"
                               name="remember"
                               type="checkbox" />
                        <label class="text-sm text-on-surface-variant select-none cursor-pointer" for="remember">Keep me signed in</label>
                    </div>

                    <button type="submit"
                            id="loginBtn"
                            data-text="Login"
                            class="w-full primary-gradient text-on-primary font-semibold py-4 rounded-lg shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all duration-200 relative flex items-center justify-center">
                        Login
                    </button>

                    <div class="relative py-4 flex items-center">
                        <div class="flex-grow border-t border-outline-variant/20"></div>
                        <span class="flex-shrink mx-4 text-[10px] uppercase tracking-[0.2em] text-outline font-bold">Or continue with</span>
                        <div class="flex-grow border-t border-outline-variant/20"></div>
                    </div>

                    <button type="button"
                            id="googleBtn"
                            onclick="handleGoogleLogin()"
                            data-text="Login with Google"
                            class="w-full flex items-center justify-center gap-3 py-3.5 px-4 bg-surface-container-high text-primary font-semibold rounded-lg hover:bg-surface-container-highest transition-colors active:scale-95 duration-200 relative">
                        <svg class="w-5 h-5" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                        </svg>
                        Login with Google
                    </button>
                </form>

                <div class="mt-10 text-center">
                    <p class="text-sm text-on-surface-variant">
                        New to The Curator?
                        <a href="/Authv/Register" class="text-primary font-bold ml-1 hover:underline">Create an account</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <script>
        // Google Client ID from config
        const GOOGLE_CLIENT_ID = '@Configuration["Google:ClientId"]?.ToString()';

        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility_off';
            }
        }

        // ============================================
        // EMAIL/PASSWORD LOGIN
        // ============================================
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const btn = document.getElementById('loginBtn');
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;
            const remember = document.getElementById('remember').checked;

            if (!email || !password) {
                showToast('Please fill in all fields');
                return;
            }

            setButtonLoading(btn, true);

            try {
                const { ipAddress, deviceName } = getClientInfo();
                const response = await ApiService.login(email, password, ipAddress, deviceName);

                TokenService.setTokens(response.accessToken, response.refreshToken);
                TokenService.setUser({ email, name: response.name || email });

                showToast('Welcome back! Redirecting...', 'success');

                setTimeout(() => {
                    const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';
                    window.location.href = returnUrl;
                }, 1000);

            } catch (error) {
                showToast(error.message || 'Invalid email or password');
            } finally {
                setButtonLoading(btn, false);
            }
        });

        // ============================================
        // GOOGLE LOGIN — Fixed implementation
        // ============================================
        let googleTokenClient = null;

        function initGoogleAuth() {
            if (!window.google || !GOOGLE_CLIENT_ID || GOOGLE_CLIENT_ID === '') {
                console.warn('Google Sign-In not configured');
                document.getElementById('googleBtn').style.display = 'none';
                return;
            }

            googleTokenClient = google.accounts.oauth2.initTokenClient({
                client_id: GOOGLE_CLIENT_ID,
                scope: 'email profile openid',
                callback: handleGoogleCallback
            });
        }

        async function handleGoogleCallback(tokenResponse) {
            if (tokenResponse.error) {
                showToast('Google sign-in failed: ' + tokenResponse.error);
                return;
            }

            const btn = document.getElementById('googleBtn');
            setButtonLoading(btn, true);

            try {
                const { ipAddress, deviceName } = getClientInfo();

                // Send Google access_token to your backend
                const apiResponse = await ApiService.googleLogin(tokenResponse.access_token, ipAddress, deviceName);

                // Store tokens from YOUR backend (not Google's)
                TokenService.setTokens(apiResponse.accessToken, apiResponse.refreshToken);

                // Fetch Google profile for UI display
                const userInfo = await fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
                    headers: { 'Authorization': `Bearer ${tokenResponse.access_token}` }
                }).then(r => r.json());

                TokenService.setUser({
                    email: userInfo.email,
                    name: userInfo.name,
                    picture: userInfo.picture
                });

                showToast('Welcome! Redirecting...', 'success');

                setTimeout(() => {
                    const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';
                    window.location.href = returnUrl;
                }, 1000);

            } catch (error) {
                showToast(error.message || 'Google login failed');
            } finally {
                setButtonLoading(btn, false);
            }
        }

        function handleGoogleLogin() {
            if (!googleTokenClient) {
                showToast('Google Sign-In is not ready yet. Please try again.');
                return;
            }
            googleTokenClient.requestAccessToken();
        }

        // Initialize Google auth when script loads
        window.onload = function() {
            initGoogleAuth();
        };

        // Redirect if already logged in
        document.addEventListener('DOMContentLoaded', () => {
            if (TokenService.isAuthenticated()) {
                const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';
                window.location.href = returnUrl;
            }
        });
    </script>
}