@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Create Your Account";
    Layout = "_Layout";
    ViewData["HideLayout"] = true;
}

<div class="flex items-center justify-center min-h-screen px-6 bg-surface py-8">
    <div class="w-full max-w-6xl grid grid-cols-1 md:grid-cols-2 gap-0 overflow-hidden rounded-xl bg-surface-container-low shadow-[0_48px_100px_rgba(0,0,0,0.08)]">

        <!-- Left Side: Editorial Content -->
        <div class="hidden md:flex flex-col justify-between relative overflow-hidden group bg-primary">
            <img alt="Minimalist luxury interior"
                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-60"
                 src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=1000&auto=format&fit=crop" />
            <div class="absolute inset-0 bg-gradient-to-b from-primary/40 via-primary/20 to-primary/60"></div>

            <div class="relative z-10 flex flex-col justify-between h-full p-12 text-white">
                <div>
                    <div class="uppercase tracking-widest text-[10px] font-medium mb-4 opacity-80">Collection 2024</div>
                    <h1 class="font-headline text-5xl font-extrabold tracking-tight leading-tight mb-6">
                        Join the circle of <br /><span class="text-on-primary-container">refined aesthetics.</span>
                    </h1>
                    <p class="text-lg opacity-90 max-w-md font-light leading-relaxed">
                        Access exclusive editorial curations, early product launches, and a seamless shopping experience tailored to your unique taste.
                    </p>
                </div>

                <!-- Bento-style feature highlight -->
                <div class="grid grid-cols-2 gap-4 mt-8">
                    <div class="bg-white/10 backdrop-blur-md p-6 rounded-xl space-y-3 border border-white/10">
                        <span class="material-symbols-outlined text-on-primary-container text-3xl">auto_awesome</span>
                        <h3 class="font-headline font-bold text-sm">Curated Feed</h3>
                        <p class="text-xs text-white/70 leading-normal">AI-driven discovery based on your style profile.</p>
                    </div>
                    <div class="bg-white/10 backdrop-blur-md p-6 rounded-xl space-y-3 border border-white/10">
                        <span class="material-symbols-outlined text-on-primary-container text-3xl">shopping_bag</span>
                        <h3 class="font-headline font-bold text-sm">Priority Access</h3>
                        <p class="text-xs text-white/70 leading-normal">Be the first to shop limited edition drops.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Signup Form -->
        <div class="bg-surface-container-lowest p-8 md:p-12 flex flex-col justify-center overflow-y-auto max-h-screen">
            <div class="max-w-md w-full mx-auto">
                <div class="mb-8">
                    <h2 class="font-headline text-3xl font-bold text-primary tracking-tight mb-2">Create Account</h2>
                    <p class="text-on-surface-variant text-sm">Start your journey with The Curator today.</p>
                </div>

                <form id="registerForm" class="space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="font-label text-xs font-semibold uppercase tracking-wider text-on-surface-variant ml-1" for="name">Full Name</label>
                            <input class="w-full bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg px-4 py-3 transition-all outline-none text-on-surface placeholder:text-outline"
                                   id="name"
                                   name="name"
                                   type="text"
                                   placeholder="John Doe"
                                   required
                                   autocomplete="name" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="font-label text-xs font-semibold uppercase tracking-wider text-on-surface-variant ml-1" for="phone">Phone Number</label>
                            <input class="w-full bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg px-4 py-3 transition-all outline-none text-on-surface placeholder:text-outline"
                                   id="phone"
                                   name="phone"
                                   type="tel"
                                   placeholder="+1 (555) 000-0000"
                                   required
                                   autocomplete="tel" />
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-label text-xs font-semibold uppercase tracking-wider text-on-surface-variant ml-1" for="email">Email Address</label>
                        <input class="w-full bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg px-4 py-3 transition-all outline-none text-on-surface placeholder:text-outline"
                               id="email"
                               name="email"
                               type="email"
                               placeholder="name@example.com"
                               required
                               autocomplete="email" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="font-label text-xs font-semibold uppercase tracking-wider text-on-surface-variant ml-1" for="password">Password</label>
                            <div class="relative">
                                <input class="w-full bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg px-4 py-3 transition-all outline-none text-on-surface placeholder:text-outline"
                                       id="password"
                                       name="password"
                                       type="password"
                                       placeholder="••••••••"
                                       required
                                       autocomplete="new-password" />
                                <button type="button" onclick="togglePassword('password', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-lg">visibility_off</span>
                                </button>
                            </div>
                        </div>
                        <div class="space-y-1.5">
                            <label class="font-label text-xs font-semibold uppercase tracking-wider text-on-surface-variant ml-1" for="confirmPassword">Confirm Password</label>
                            <div class="relative">
                                <input class="w-full bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg px-4 py-3 transition-all outline-none text-on-surface placeholder:text-outline"
                                       id="confirmPassword"
                                       name="confirmPassword"
                                       type="password"
                                       placeholder="••••••••"
                                       required
                                       autocomplete="new-password" />
                                <button type="button" onclick="togglePassword('confirmPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-lg">visibility_off</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 pt-2">
                        <input class="mt-1 w-5 h-5 rounded text-primary focus:ring-primary border-outline-variant accent-primary cursor-pointer"
                               id="terms"
                               name="terms"
                               type="checkbox"
                               required />
                        <label for="terms" class="text-xs text-on-surface-variant leading-relaxed cursor-pointer select-none">
                            By signing up, you agree to our <a href="#" class="text-primary font-semibold hover:underline">Terms of Service</a> and <a href="#" class="text-primary font-semibold hover:underline">Privacy Policy</a>.
                        </label>
                    </div>

                    <button type="submit"
                            id="registerBtn"
                            data-text="Sign Up"
                            class="w-full primary-gradient text-on-primary font-headline font-bold py-4 rounded-lg shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all duration-200 relative flex items-center justify-center">
                        Sign Up
                    </button>

                    <div class="relative py-4 flex items-center">
                        <div class="flex-grow border-t border-outline-variant/20"></div>
                        <span class="flex-shrink mx-4 text-[10px] uppercase tracking-[0.2em] text-outline font-bold">Or continue with</span>
                        <div class="flex-grow border-t border-outline-variant/20"></div>
                    </div>

                    <button type="button"
                            id="googleBtn"
                            data-text="Sign Up with Google"
                            onclick="handleGoogleLogin()"
                            class="w-full flex items-center justify-center gap-3 py-3.5 px-4 bg-surface-container-high text-primary font-semibold rounded-lg hover:bg-surface-container-highest transition-colors active:scale-95 duration-200 relative">
                        <svg class="w-5 h-5" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                        </svg>
                        Sign Up with Google
                    </button>
                </form>

                <div class="mt-8 text-center">
                    <p class="text-sm text-on-surface-variant">
                        Already have an account?
                        <a href="/Authv/Login" class="text-primary font-bold ml-1 hover:underline">Log In</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <script>
        const GOOGLE_CLIENT_ID = '@Configuration["Google:ClientId"]?.ToString()';

        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility_off';
            }
        }

        // ============================================
        // EMAIL/PASSWORD REGISTRATION
        // ============================================
        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const btn = document.getElementById('registerBtn');
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const terms = document.getElementById('terms').checked;

            if (!name || !email || !phone || !password || !confirmPassword) {
                showToast('Please fill in all fields');
                return;
            }

            if (password !== confirmPassword) {
                showToast('Passwords do not match');
                return;
            }

            if (!terms) {
                showToast('Please accept the Terms of Service');
                return;
            }

            setButtonLoading(btn, true);

            try {
                const { ipAddress, deviceName } = getClientInfo();
                const response = await ApiService.register(email, name, password, confirmPassword, phone, ipAddress, deviceName);

                TokenService.setTokens(response.accessToken, response.refreshToken);
                TokenService.setUser({ email, name });

                showToast('Account created! Redirecting...', 'success');

                setTimeout(() => {
                    const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';
                    window.location.href = returnUrl;
                }, 1000);

            } catch (error) {
                showToast(error.message || 'Registration failed. Please try again.');
            } finally {
                setButtonLoading(btn, false);
            }
        });

        // ============================================
        // GOOGLE SIGN UP — Same pattern as login
        // ============================================
        let googleTokenClient = null;

        function initGoogleAuth() {
            if (!window.google || !GOOGLE_CLIENT_ID || GOOGLE_CLIENT_ID === '') {
                console.warn('Google Sign-In not configured');
                document.getElementById('googleBtn').style.display = 'none';
                return;
            }

            googleTokenClient = google.accounts.oauth2.initTokenClient({
                client_id: GOOGLE_CLIENT_ID,
                scope: 'email profile openid',
                callback: handleGoogleCallback
            });
        }

        async function handleGoogleCallback(tokenResponse) {
            if (tokenResponse.error) {
                showToast('Google sign-in failed: ' + tokenResponse.error);
                return;
            }

            const btn = document.getElementById('googleBtn');
            setButtonLoading(btn, true);

            try {
                const { ipAddress, deviceName } = getClientInfo();

                const apiResponse = await ApiService.googleLogin(tokenResponse.access_token, ipAddress, deviceName);

                TokenService.setTokens(apiResponse.accessToken, apiResponse.refreshToken);

                const userInfo = await fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
                    headers: { 'Authorization': `Bearer ${tokenResponse.access_token}` }
                }).then(r => r.json());

                TokenService.setUser({
                    email: userInfo.email,
                    name: userInfo.name,
                    picture: userInfo.picture
                });

                showToast('Welcome! Redirecting...', 'success');

                setTimeout(() => {
                    const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';
                    window.location.href = returnUrl;
                }, 1000);

            } catch (error) {
                showToast(error.message || 'Google signup failed');
            } finally {
                setButtonLoading(btn, false);
            }
        }

        function handleGoogleLogin() {
            if (!googleTokenClient) {
                showToast('Google Sign-In is not ready yet. Please try again.');
                return;
            }
            googleTokenClient.requestAccessToken();
        }

        window.onload = function() {
            initGoogleAuth();
        };

        document.addEventListener('DOMContentLoaded', () => {
            if (TokenService.isAuthenticated()) {
                const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';
                window.location.href = returnUrl;
            }
        });
    </script>
}