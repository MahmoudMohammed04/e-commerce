@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
    ViewData["HideLayout"] = true;
}

<div class="flex items-center justify-center min-h-screen px-6 bg-surface">
    <div class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-12 gap-0 overflow-hidden rounded-xl bg-surface-container-low shadow-[0_48px_100px_rgba(0,0,0,0.08)]">

        <!-- Left Visual Side -->
        <div class="hidden md:flex md:col-span-6 relative overflow-hidden group">
            <img alt="Luxury lifestyle"
                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                 src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=1000&auto=format&fit=crop" />
            <div class="absolute inset-0 bg-primary/30"></div>
            <div class="relative z-10 flex flex-col justify-end p-12 text-white h-full">
                <div class="uppercase tracking-widest text-[10px] font-medium mb-4 opacity-80">Collection 2024</div>
                <h1 class="font-headline text-5xl font-extrabold tracking-tighter leading-none mb-6">Reset your access.</h1>
                <p class="text-lg opacity-90 max-w-sm font-light leading-relaxed">Securely restore your curation account in just a few steps.</p>
            </div>
        </div>

        <!-- Right Form Side -->
        <div class="md:col-span-6 bg-surface-container-lowest p-8 md:p-16 flex flex-col justify-center">
            <div class="max-w-md w-full mx-auto">

                <!-- Step 1: Email Input -->
                <div id="step-email">
                    <div class="mb-10">
                        <h2 class="font-headline text-3xl font-bold text-primary tracking-tight mb-2">Forgot Password?</h2>
                        <p class="text-on-surface-variant text-sm">Enter your email address and we will send you a reset code.</p>
                    </div>

                    <form id="forgotForm" class="space-y-6">
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="email">Email Address</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-lg">mail</span>
                                <input class="w-full pl-12 pr-4 py-3.5 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                                       id="email"
                                       name="email"
                                       type="email"
                                       placeholder="curator@example.com"
                                       required
                                       autocomplete="email" />
                            </div>
                        </div>

                        <button type="submit"
                                id="submitBtn"
                                data-text="Send Reset Code"
                                class="w-full primary-gradient text-on-primary font-semibold py-4 rounded-lg shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all duration-200 relative flex items-center justify-center">
                            Send Reset Code
                        </button>
                    </form>
                </div>

                <!-- Step 2: Reset Password (Code + New Password + Confirm) -->
                <div id="step-reset" class="hidden">
                    <div class="mb-10">
                        <h2 class="font-headline text-3xl font-bold text-primary tracking-tight mb-2">Create New Password</h2>
                        <p class="text-on-surface-variant text-sm">Enter the code sent to <span class="text-primary font-semibold" id="resetEmailDisplay"></span> and set your new password.</p>
                    </div>

                    <form id="resetForm" class="space-y-6">
                        <!-- Code Input -->
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="code">Reset Code</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-lg">vpn_key</span>
                                <input class="w-full pl-12 pr-4 py-3.5 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline tracking-widest font-mono"
                                       id="code"
                                       name="code"
                                       type="text"
                                       placeholder="000000"
                                       required
                                       maxlength="10"
                                       autocomplete="one-time-code" />
                            </div>
                        </div>

                        <!-- New Password -->
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="newPassword">New Password</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-lg">lock</span>
                                <input class="w-full pl-12 pr-12 py-3.5 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                                       id="newPassword"
                                       name="newPassword"
                                       type="password"
                                       placeholder="••••••••"
                                       required
                                       minlength="6"
                                       autocomplete="new-password" />
                                <button type="button" onclick="togglePassword('newPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-lg">visibility_off</span>
                                </button>
                            </div>
                            <p class="text-[11px] text-on-surface-variant/70">Minimum 6 characters</p>
                        </div>

                        <!-- Confirm Password -->
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="confirmPassword">Confirm Password</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-lg">lock_reset</span>
                                <input class="w-full pl-12 pr-12 py-3.5 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                                       id="confirmPassword"
                                       name="confirmPassword"
                                       type="password"
                                       placeholder="••••••••"
                                       required
                                       minlength="6"
                                       autocomplete="new-password" />
                                <button type="button" onclick="togglePassword('confirmPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-lg">visibility_off</span>
                                </button>
                            </div>
                        </div>

                        <button type="submit"
                                id="resetBtn"
                                data-text="Reset Password"
                                class="w-full primary-gradient text-on-primary font-semibold py-4 rounded-lg shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all duration-200 relative flex items-center justify-center">
                            Reset Password
                        </button>
                    </form>
                </div>

                <!-- Step 3: Success Message -->
                <div id="step-success" class="hidden text-center py-8">
                    <div class="w-16 h-16 rounded-full bg-[#00685d]/10 flex items-center justify-center mx-auto mb-6">
                        <span class="material-symbols-outlined text-3xl text-[#00685d]">check_circle</span>
                    </div>
                    <h2 class="font-headline text-2xl font-bold text-primary tracking-tight mb-3">Password Reset!</h2>
                    <p class="text-on-surface-variant text-sm mb-8 leading-relaxed">Your password has been successfully updated.<br>You can now sign in with your new password.</p>
                    <a href="/Authv/Login" class="inline-flex items-center justify-center w-full primary-gradient text-on-primary font-semibold py-4 rounded-lg shadow-lg hover:opacity-90 active:scale-95 transition-all">
                        Sign In
                    </a>
                </div>

                <div class="mt-10 text-center">
                    <p class="text-sm text-on-surface-variant">
                        <a href="/Authv/Login" class="inline-flex items-center gap-2 text-primary font-bold hover:opacity-80 transition-opacity">
                            <span class="material-symbols-outlined text-lg">arrow_back</span>
                            Back to Sign In
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let resetEmail = '';

        // ============================================
        // STEP 1: SEND RESET CODE
        // ============================================
        document.getElementById('forgotForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const btn = document.getElementById('submitBtn');
            const email = document.getElementById('email').value.trim();

            if (!email) {
                showToast('Please enter your email address');
                return;
            }

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(email)) {
                showToast('Please enter a valid email address');
                return;
            }

            setButtonLoading(btn, true);

            try {
                await ApiService.forgotPassword(email);
                resetEmail = email;

                // Show reset form
                document.getElementById('step-email').classList.add('hidden');
                document.getElementById('step-reset').classList.remove('hidden');
                document.getElementById('resetEmailDisplay').textContent = email;

                // Auto-focus code input
                setTimeout(() => document.getElementById('code').focus(), 100);

            } catch (error) {
                showToast(error.message || 'Failed to send reset code. Please try again.');
            } finally {
                setButtonLoading(btn, false);
            }
        });

        // ============================================
        // STEP 2: RESET PASSWORD
        // ============================================
        document.getElementById('resetForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const btn = document.getElementById('resetBtn');
            const code = document.getElementById('code').value.trim();
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (!code) {
                showToast('Please enter the reset code');
                return;
            }

            if (!newPassword || !confirmPassword) {
                showToast('Please fill in all password fields');
                return;
            }

            if (newPassword.length < 6) {
                showToast('Password must be at least 6 characters');
                return;
            }

            if (newPassword !== confirmPassword) {
                showToast('Passwords do not match');
                return;
            }

            setButtonLoading(btn, true);

            try {
                await ApiService.resetPassword(resetEmail, code, newPassword, confirmPassword);

                // Show success
                document.getElementById('step-reset').classList.add('hidden');
                document.getElementById('step-success').classList.remove('hidden');

            } catch (error) {
                showToast(error.message || 'Failed to reset password. Please check your code and try again.');
            } finally {
                setButtonLoading(btn, false);
            }
        });

        // ============================================
        // PASSWORD VISIBILITY TOGGLE
        // ============================================
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility_off';
            }
        }

        // Redirect if already logged in
        document.addEventListener('DOMContentLoaded', () => {
            if (TokenService.isAuthenticated()) {
                window.location.href = '/';
            }
        });
    </script>
}