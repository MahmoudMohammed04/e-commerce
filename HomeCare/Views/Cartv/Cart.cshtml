@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-6 md:px-8 pt-24 pb-16">
    <!-- Header -->
    <div class="flex items-center justify-between mb-10">
        <div>
            <h1 class="font-headline text-3xl md:text-4xl font-bold text-primary tracking-tight">Your Cart</h1>
            <p class="text-on-surface-variant text-sm mt-2" id="cartCount">Loading...</p>
        </div>
        <a href="/Productv/Index" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:opacity-80 transition-opacity">
            <span class="material-symbols-outlined">arrow_back</span>
            Continue Shopping
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <!-- Cart Items -->
        <div class="lg:col-span-8">
            <div id="cartItems" class="space-y-4">
                <!-- Populated by JS -->
            </div>

            <!-- Loading State -->
            <div id="cartLoading" class="py-20 text-center">
                <div class="inline-block w-8 h-8 border-2 border-primary/20 border-t-primary rounded-full animate-spin"></div>
                <p class="text-on-surface-variant text-sm mt-3">Loading your cart...</p>
            </div>

            <!-- Empty State -->
            <div id="cartEmpty" class="hidden py-20 text-center">
                <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">shopping_cart</span>
                <h3 class="font-headline text-xl font-bold text-primary mb-2">Your cart is empty</h3>
                <p class="text-on-surface-variant text-sm mb-6">Discover our curated collection and add something special.</p>
                <a href="/Productv/Index" class="inline-flex items-center gap-2 px-6 py-3 primary-gradient text-on-primary font-semibold rounded-lg hover:opacity-90 transition-opacity">
                    <span class="material-symbols-outlined">storefront</span>
                    Browse Collection
                </a>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="lg:col-span-4">
            <div id="orderSummary" class="bg-surface-container-low p-6 md:p-8 rounded-xl shadow-[0_12px_48px_rgba(0,11,96,0.06)] sticky top-24 hidden">
                <h3 class="font-headline text-xl font-bold text-primary mb-6">Order Summary</h3>

                <div class="space-y-4 mb-6">
                    <div class="flex justify-between text-sm">
                        <span class="text-on-surface-variant">Subtotal</span>
                        <span class="font-semibold text-primary" id="subtotal">$0.00</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-on-surface-variant">Shipping</span>
                        <span class="font-semibold text-primary">Free</span>
                    </div>
                    <div class="border-t border-outline-variant/20 pt-4 flex justify-between">
                        <span class="font-bold text-primary">Total</span>
                        <span class="font-bold text-primary text-lg" id="total">$0.00</span>
                    </div>
                </div>

                <button onclick="openCheckoutModal()" class="w-full py-4 primary-gradient text-on-primary font-bold rounded-lg shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all mb-4">
                    Proceed to Checkout
                </button>

                <button onclick="clearCart()" class="w-full py-3 text-sm font-bold text-outline hover:text-error transition-colors flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">delete_sweep</span>
                    Clear Cart
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Checkout Modal -->
<div id="checkoutModal" class="fixed inset-0 z-[60] hidden">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity" onclick="closeCheckoutModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4 md:p-6 pointer-events-none">
        <div class="bg-surface-container-lowest w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-2xl shadow-[0_24px_80px_rgba(0,0,0,0.2)] pointer-events-auto custom-scrollbar">
            <!-- Modal Header -->
            <div class="sticky top-0 bg-surface-container-lowest z-10 px-6 md:px-8 py-5 border-b border-outline-variant/10 flex items-center justify-between">
                <div>
                    <h2 class="font-headline text-2xl font-bold text-primary tracking-tight">Checkout</h2>
                    <p class="text-on-surface-variant text-xs mt-1">Complete your purchase securely</p>
                </div>
                <button onclick="closeCheckoutModal()" class="w-10 h-10 rounded-full hover:bg-surface-container-high flex items-center justify-center text-on-surface-variant transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form id="checkoutForm" class="px-6 md:px-8 py-6 space-y-8">
                <!-- Step Indicator -->
                <div class="flex items-center gap-2 mb-2">
                    <div class="flex items-center gap-2" id="step-indicator-1">
                        <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center text-sm font-bold">1</div>
                        <span class="text-sm font-semibold text-primary">Shipping</span>
                    </div>
                    <div class="flex-1 h-px bg-outline-variant/30 mx-2"></div>
                    <div class="flex items-center gap-2" id="step-indicator-2">
                        <div class="w-8 h-8 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center text-sm font-bold">2</div>
                        <span class="text-sm font-semibold text-on-surface-variant">Payment</span>
                    </div>
                </div>

                <!-- Step 1: Shipping Info -->
                <div id="checkout-step-1" class="space-y-5">
                    <h3 class="font-label text-xs uppercase tracking-widest font-bold text-primary">Shipping Details</h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="fullName">Full Name</label>
                            <input type="text" id="fullName" name="fullName" required
                                   class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                                   placeholder="John Doe" />
                        </div>
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="email">Email</label>
                            <input type="email" id="email" name="email" required
                                   class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                                   placeholder="john@example.com" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="phoneNumber">Phone Number</label>
                        <input type="tel" id="phoneNumber" name="phoneNumber" required
                               class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                               placeholder="+1 234 567 8900" />
                    </div>

                    <div class="space-y-2">
                        <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="streetAddress">Street Address</label>
                        <input type="text" id="streetAddress" name="streetAddress" required
                               class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                               placeholder="123 Main Street, Apt 4B" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="countryId">Country</label>
                            <select id="countryId" name="countryId" required onchange="onCountryChange(this.value)"
                                    class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface cursor-pointer">
                                <option value="">Select Country</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="cityId">City</label>
                            <select id="cityId" name="cityId" required
                                    class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                                <option value="">Select City</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="postalCode">Postal Code</label>
                            <input type="text" id="postalCode" name="postalCode"
                                   class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                                   placeholder="10001" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="state">State / Province</label>
                        <input type="text" id="state" name="state"
                               class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                               placeholder="New York" />
                    </div>

                    <button type="button" onclick="goToPaymentStep()"
                            class="w-full py-4 primary-gradient text-on-primary font-bold rounded-lg shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all">
                        Continue to Payment
                    </button>
                </div>

                <!-- Step 2: Payment Info -->
                <div id="checkout-step-2" class="space-y-5 hidden">
                    <h3 class="font-label text-xs uppercase tracking-widest font-bold text-primary">Payment Details</h3>

                    <div class="bg-surface-container-low rounded-lg p-4 flex justify-between items-center">
                        <span class="text-sm text-on-surface-variant">Amount to pay</span>
                        <span class="font-bold text-primary text-xl" id="checkoutTotal">$0.00</span>
                    </div>

                    <div class="space-y-2">
                        <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="cardHolderName">Cardholder Name</label>
                        <input type="text" id="cardHolderName" name="cardHolderName" required
                               class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline"
                               placeholder="John Doe" />
                    </div>

                    <div class="space-y-2">
                        <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="cardNumber">Card Number</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">credit_card</span>
                            <input type="text" id="cardNumber" name="cardNumber" required maxlength="19"
                                   class="w-full pl-12 pr-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline font-mono tracking-wider"
                                   placeholder="4242 4242 4242 4242"
                                   oninput="formatCardNumber(this)" />
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-4">
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="expirationMonth">Month</label>
                            <select id="expirationMonth" name="expirationMonth" required
                                    class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface cursor-pointer">
                                <option value="">MM</option>
                                <option value="1">01</option>
                                <option value="2">02</option>
                                <option value="3">03</option>
                                <option value="4">04</option>
                                <option value="5">05</option>
                                <option value="6">06</option>
                                <option value="7">07</option>
                                <option value="8">08</option>
                                <option value="9">09</option>
                                <option value="10">10</option>
                                <option value="11">11</option>
                                <option value="12">12</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="expirationYear">Year</label>
                            <select id="expirationYear" name="expirationYear" required
                                    class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface cursor-pointer">
                                <option value="">YY</option>
                                <option value="2025">2025</option>
                                <option value="2026">2026</option>
                                <option value="2027">2027</option>
                                <option value="2028">2028</option>
                                <option value="2029">2029</option>
                                <option value="2030">2030</option>
                                <option value="2031">2031</option>
                                <option value="2032">2032</option>
                                <option value="2033">2033</option>
                                <option value="2034">2034</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="font-label text-xs uppercase tracking-widest font-medium text-on-surface-variant" for="cvv">CVV</label>
                            <input type="text" id="cvv" name="cvv" required maxlength="4"
                                   class="w-full px-4 py-3 bg-surface-container-low border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg transition-all outline-none text-on-surface placeholder:text-outline font-mono tracking-wider"
                                   placeholder="123" />
                        </div>
                    </div>

                    <div class="flex gap-3 pt-2">
                        <button type="button" onclick="goToShippingStep()"
                                class="flex-1 py-4 border border-outline-variant text-primary font-bold rounded-lg hover:bg-surface-container-high transition-all">
                            Back
                        </button>
                        <button type="submit" id="payBtn" data-text="Pay Now"
                                class="flex-[2] py-4 primary-gradient text-on-primary font-bold rounded-lg shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all relative flex items-center justify-center">
                            Pay Now
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="fixed inset-0 z-[70] hidden flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <div class="bg-surface-container-lowest rounded-2xl p-8 md:p-12 max-w-md w-full text-center shadow-[0_24px_80px_rgba(0,0,0,0.2)] relative z-10">
        <div class="w-20 h-20 rounded-full bg-[#00685d]/10 flex items-center justify-center mx-auto mb-6">
            <span class="material-symbols-outlined text-4xl text-[#00685d]">check_circle</span>
        </div>
        <h2 class="font-headline text-2xl font-bold text-primary mb-3">Payment Successful!</h2>
        <p class="text-on-surface-variant text-sm mb-8">Your order has been placed successfully. You will receive a confirmation email shortly.</p>
        <a href="/Productv/Index" class="inline-flex items-center justify-center w-full primary-gradient text-on-primary font-semibold py-4 rounded-lg shadow-lg hover:opacity-90 transition-opacity">
            Continue Shopping
        </a>
    </div>
</div>

@section Styles {
    <style>
        .cart-item-enter {
            animation: slideIn 0.3s ease-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .cart-item-exit {
            animation: slideOut 0.3s ease-in forwards;
        }

        @@keyframes slideOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }

            to {
                opacity: 0;
                transform: translateX(20px);
            }
        }

        #checkoutModal {
            transition: opacity 0.2s ease;
        }

            #checkoutModal.hidden {
                opacity: 0;
                pointer-events: none;
            }

            #checkoutModal:not(.hidden) {
                opacity: 1;
            }
    </style>
}

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        let cartData = [];
        let cartPage = 1;
        let cartPageSize = 15;
        let stripe = null;
        let countriesLoaded = false;
        let citiesCache = {};

        document.addEventListener('DOMContentLoaded', () => {
            loadCart();
            const stripeKey = '@Configuration["Stripe:PublishableKey"]?.ToString()';
            if (stripeKey && stripeKey !== '') {
                stripe = Stripe(stripeKey);
            }
        });

        // ============================================
        // LOCATION: Load Countries & Cities
        // ============================================
        async function loadCountries() {
            if (countriesLoaded) return;
            const select = document.getElementById('countryId');
            const citySelect = document.getElementById('cityId');
            try {
                const countries = await ApiService.getCountries();
                select.innerHTML = '<option value="">Select Country</option>';
                countries.forEach(c => {
                    const option = document.createElement('option');
                    option.value = c.id;
                    option.textContent = c.name;
                    select.appendChild(option);
                });
                countriesLoaded = true;
            } catch (e) {
                console.error('Failed to load countries:', e);
                select.innerHTML = '<option value="">Failed to load</option>';
            }
        }

        async function onCountryChange(countryId) {
            const citySelect = document.getElementById('cityId');
            if (!countryId) {
                citySelect.innerHTML = '<option value="">Select City</option>';
                citySelect.disabled = true;
                return;
            }

            // Check cache
            if (citiesCache[countryId]) {
                populateCities(citiesCache[countryId]);
                return;
            }

            citySelect.innerHTML = '<option value="">Loading...</option>';
            citySelect.disabled = true;

            try {
                const cities = await ApiService.getCities(countryId);
                citiesCache[countryId] = cities;
                populateCities(cities);
            } catch (e) {
                console.error('Failed to load cities:', e);
                citySelect.innerHTML = '<option value="">Failed to load</option>';
                citySelect.disabled = true;
            }
        }

        function populateCities(cities) {
            const citySelect = document.getElementById('cityId');
            citySelect.innerHTML = '<option value="">Select City</option>';
            cities.forEach(c => {
                const option = document.createElement('option');
                option.value = c.id;
                option.textContent = c.name;
                citySelect.appendChild(option);
            });
            citySelect.disabled = false;
        }

        // ============================================
        // CART
        // ============================================
        async function loadCart() {
            const itemsContainer = document.getElementById('cartItems');
            const loading = document.getElementById('cartLoading');
            const empty = document.getElementById('cartEmpty');
            const summary = document.getElementById('orderSummary');

            itemsContainer.innerHTML = '';
            loading.classList.remove('hidden');
            empty.classList.add('hidden');
            summary.classList.add('hidden');

            try {
                const response = await ApiService.getCart(cartPage, cartPageSize);
                if (Array.isArray(response)) {
                    cartData = response;
                } else if (response && response.items) {
                    cartData = response.items;
                } else if (response && response.data) {
                    cartData = response.data;
                } else {
                    cartData = [];
                }

                loading.classList.add('hidden');

                if (!cartData || cartData.length === 0) {
                    empty.classList.remove('hidden');
                    document.getElementById('cartCount').textContent = '0 items';
                    return;
                }

                document.getElementById('cartCount').textContent =
                    `${cartData.length} item${cartData.length !== 1 ? 's' : ''}`;

                cartData.forEach((item, index) => {
                    const card = createCartItem(item, index);
                    itemsContainer.appendChild(card);
                });

                summary.classList.remove('hidden');
                updateSummary();

            } catch (error) {
                loading.classList.add('hidden');
                empty.classList.remove('hidden');
                showToast(error.message || 'Failed to load cart');
                document.getElementById('cartCount').textContent = 'Failed to load';
            }
        }

        function createCartItem(item, index) {
            const div = document.createElement('div');
            div.className = 'cart-item-enter bg-surface-container-lowest rounded-xl p-4 md:p-6 flex gap-4 md:gap-6 items-center shadow-[0_4px_16px_rgba(0,11,96,0.04)]';
            div.id = `cart-item-${item.id}`;
            const price = item.price || 0;
            div.innerHTML = `
                <div class="w-24 h-24 md:w-28 md:h-28 flex-shrink-0 bg-surface-container-low rounded-lg overflow-hidden">
                    <img src="${item.image || 'https://via.placeholder.com/112?text=No+Image'}"
                         alt="${item.name}"
                         class="w-full h-full object-contain"
                         onerror="this.src='https://via.placeholder.com/112?text=No+Image'" />
                </div>
                <div class="flex-grow min-w-0">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
                        <div class="min-w-0">
                            <h3 class="font-headline text-lg font-bold text-primary truncate">${item.name}</h3>
                            <p class="text-on-surface-variant text-xs mt-1">${item.categoryName || ''} ${item.brandName ? '· ' + item.brandName : ''}</p>
                            <p class="text-on-surface-variant text-xs mt-0.5 line-clamp-1">${item.description || ''}</p>
                        </div>
                        <div class="flex items-center gap-4 flex-shrink-0">
                            <span class="font-bold text-primary font-headline text-lg">$${price.toFixed(2)}</span>
                        </div>
                    </div>
                    <div class="flex items-center justify-between mt-4">
                        <div class="flex items-center gap-3">
                            <button onclick="updateQuantity(${item.id}, -1)"
                                    class="w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
                                <span class="material-symbols-outlined text-sm">remove</span>
                            </button>
                            <span class="font-semibold text-primary w-8 text-center" id="qty-${item.id}">1</span>
                            <button onclick="updateQuantity(${item.id}, 1)"
                                    class="w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
                                <span class="material-symbols-outlined text-sm">add</span>
                            </button>
                        </div>
                        <button onclick="removeItem(${item.id})"
                                class="text-outline hover:text-error transition-colors p-2 rounded-lg hover:bg-error-container/30">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                    </div>
                </div>
            `;
            return div;
        }

        async function updateQuantity(productId, delta) {
            const qtyEl = document.getElementById(`qty-${productId}`);
            let currentQty = parseInt(qtyEl.textContent) || 1;
            let newQty = currentQty + delta;
            if (newQty < 1) return;
            qtyEl.textContent = newQty;
            updateSummary();
        }

        async function removeItem(productId) {
            const itemEl = document.getElementById(`cart-item-${productId}`);
            if (!itemEl) return;
            itemEl.classList.remove('cart-item-enter');
            itemEl.classList.add('cart-item-exit');
            try {
                await ApiService.removeFromCart(productId);
                setTimeout(() => {
                    itemEl.remove();
                    cartData = cartData.filter(i => i.id !== productId);
                    if (cartData.length === 0) {
                        document.getElementById('cartEmpty').classList.remove('hidden');
                        document.getElementById('orderSummary').classList.add('hidden');
                    }
                    document.getElementById('cartCount').textContent =
                        `${cartData.length} item${cartData.length !== 1 ? 's' : ''}`;
                    updateSummary();
                    showToast('Item removed from cart', 'success');
                }, 300);
            } catch (error) {
                itemEl.classList.remove('cart-item-exit');
                showToast(error.message || 'Failed to remove item');
            }
        }

        async function clearCart() {
            if (!confirm('Are you sure you want to clear your cart?')) return;
            try {
                await ApiService.clearCart();
                document.getElementById('cartItems').innerHTML = '';
                cartData = [];
                document.getElementById('cartEmpty').classList.remove('hidden');
                document.getElementById('orderSummary').classList.add('hidden');
                document.getElementById('cartCount').textContent = '0 items';
                showToast('Cart cleared', 'success');
            } catch (error) {
                showToast(error.message || 'Failed to clear cart');
            }
        }

        function updateSummary() {
            const subtotal = cartData.reduce((sum, item) => {
                const qty = parseInt(document.getElementById(`qty-${item.id}`)?.textContent || 1);
                return sum + (item.price || 0) * qty;
            }, 0);
            document.getElementById('subtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('total').textContent = `$${subtotal.toFixed(2)}`;
        }

        // ============================================
        // CHECKOUT MODAL
        // ============================================
        function openCheckoutModal() {
            document.getElementById('checkoutModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            document.getElementById('checkoutTotal').textContent = document.getElementById('total').textContent;
            loadCountries();
        }

        function closeCheckoutModal() {
            document.getElementById('checkoutModal').classList.add('hidden');
            document.body.style.overflow = '';
            goToShippingStep();
        }

        function goToPaymentStep() {
            const required = ['fullName', 'email', 'phoneNumber', 'streetAddress', 'countryId', 'cityId'];
            for (const field of required) {
                const el = document.getElementById(field);
                if (!el.value.trim()) {
                    el.focus();
                    el.classList.add('ring-2', 'ring-error');
                    setTimeout(() => el.classList.remove('ring-2', 'ring-error'), 2000);
                    showToast('Please fill in all required fields');
                    return;
                }
            }
            document.getElementById('checkout-step-1').classList.add('hidden');
            document.getElementById('checkout-step-2').classList.remove('hidden');
            document.querySelector('#step-indicator-1 div').className = 'w-8 h-8 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center text-sm font-bold';
            document.querySelector('#step-indicator-1 span').className = 'text-sm font-semibold text-on-surface-variant';
            document.querySelector('#step-indicator-2 div').className = 'w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center text-sm font-bold';
            document.querySelector('#step-indicator-2 span').className = 'text-sm font-semibold text-primary';
        }

        function goToShippingStep() {
            document.getElementById('checkout-step-2').classList.add('hidden');
            document.getElementById('checkout-step-1').classList.remove('hidden');
            document.querySelector('#step-indicator-2 div').className = 'w-8 h-8 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center text-sm font-bold';
            document.querySelector('#step-indicator-2 span').className = 'text-sm font-semibold text-on-surface-variant';
            document.querySelector('#step-indicator-1 div').className = 'w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center text-sm font-bold';
            document.querySelector('#step-indicator-1 span').className = 'text-sm font-semibold text-primary';
        }

        function formatCardNumber(input) {
            let value = input.value.replace(/\s/g, '').replace(/\D/g, '');
            let formatted = '';
            for (let i = 0; i < value.length; i++) {
                if (i > 0 && i % 4 === 0) formatted += ' ';
                formatted += value[i];
            }
            input.value = formatted;
        }

        // ============================================
        // CHECKOUT SUBMIT
        // ============================================
        document.getElementById('checkoutForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('payBtn');
            const cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
            const cvv = document.getElementById('cvv').value;
            const month = document.getElementById('expirationMonth').value;
            const year = document.getElementById('expirationYear').value;

            if (cardNumber.length < 13) {
                showToast('Please enter a valid card number');
                return;
            }
            if (!month || !year) {
                showToast('Please select expiration date');
                return;
            }
            if (cvv.length < 3) {
                showToast('Please enter a valid CVV');
                return;
            }

            setButtonLoading(btn, true);

            const checkoutData = {
                fullName: document.getElementById('fullName').value.trim(),
                email: document.getElementById('email').value.trim(),
                phoneNumber: document.getElementById('phoneNumber').value.trim(),
                streetAddress: document.getElementById('streetAddress').value.trim(),
                cityId: parseInt(document.getElementById('cityId').value),
                countryId: parseInt(document.getElementById('countryId').value),
                state: document.getElementById('state').value.trim() || null,
                postalCode: document.getElementById('postalCode').value.trim() || null,
                paymentRequest: {
                    cardHolderName: document.getElementById('cardHolderName').value.trim(),
                    cardNumber: cardNumber,
                    expirationMonth: parseInt(month),
                    expirationYear: parseInt(year),
                    cvv: cvv
                }
            };

            try {
                const clientSecret = await ApiService.checkout(checkoutData);
                if (!clientSecret || typeof clientSecret !== 'string') {
                    throw new Error('Invalid payment session');
                }
                if (!stripe) {
                    const stripeKey = '@Configuration["Stripe:PublishableKey"]?.ToString()';
                    if (!stripeKey || stripeKey === '') {
                        throw new Error('Stripe not configured');
                    }
                    stripe = Stripe(stripeKey);
                }
                const { error, paymentIntent } = await stripe.confirmCardPayment(clientSecret, {
                    payment_method: {
                        card: {
                            number: checkoutData.paymentRequest.cardNumber,
                            exp_month: checkoutData.paymentRequest.expirationMonth,
                            exp_year: checkoutData.paymentRequest.expirationYear,
                            cvc: checkoutData.paymentRequest.cvv,
                        },
                        billing_details: {
                            name: checkoutData.paymentRequest.cardHolderName,
                            email: checkoutData.email,
                            phone: checkoutData.phoneNumber,
                            address: {
                                line1: checkoutData.streetAddress,
                                city: document.getElementById('cityId').options[document.getElementById('cityId').selectedIndex].text,
                                country: document.getElementById('countryId').options[document.getElementById('countryId').selectedIndex].text,
                                state: checkoutData.state || undefined,
                                postal_code: checkoutData.postalCode || undefined,
                            }
                        }
                    }
                });
                if (error) {
                    throw new Error(error.message);
                }
                if (paymentIntent && paymentIntent.status === 'succeeded') {
                    closeCheckoutModal();
                    document.getElementById('successModal').classList.remove('hidden');
                    document.getElementById('cartItems').innerHTML = '';
                    cartData = [];
                    document.getElementById('cartEmpty').classList.remove('hidden');
                    document.getElementById('orderSummary').classList.add('hidden');
                    document.getElementById('cartCount').textContent = '0 items';
                } else {
                    throw new Error('Payment was not completed');
                }
            } catch (error) {
                showToast(error.message || 'Payment failed. Please try again.');
            } finally {
                setButtonLoading(btn, false);
            }
        });
    </script>
}