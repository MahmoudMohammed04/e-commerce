@{
    ViewData["Title"] = "Best Sellers";
    Layout = "_Layout";
}

<!-- Hero Section -->
<section class="relative w-full h-[500px] md:h-[614px] overflow-hidden bg-primary-container">
    <div class="absolute inset-0">
        <img class="w-full h-full object-cover opacity-40"
             src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=2000&auto=format&fit=crop"
             alt="Hero background" />
        <div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-transparent"></div>
    </div>
    <div class="relative h-full max-w-7xl mx-auto px-6 md:px-8 flex flex-col justify-center items-start">
        <span class="bg-tertiary-container text-tertiary-fixed px-4 py-1.5 rounded-full text-xs font-bold tracking-[0.2em] uppercase mb-6">Curated Collection</span>
        <h1 class="text-white text-5xl md:text-7xl lg:text-8xl font-extrabold tracking-tighter max-w-3xl leading-[0.9] font-headline">Curated <br />Masterpieces.</h1>
        <p class="text-indigo-100/80 mt-6 md:mt-8 max-w-lg text-base md:text-lg font-body leading-relaxed">Experience our most sought-after pieces, hand-selected for the discerning collector.</p>
        <div class="mt-8 md:mt-10 flex gap-4">
            <button onclick="scrollToProducts()" class="bg-gradient-to-br from-primary to-primary-container text-white px-6 md:px-8 py-3 md:py-4 rounded-lg font-bold tracking-tight hover:brightness-110 transition-all flex items-center gap-2">
                Shop Collection
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </button>
        </div>
    </div>
</section>

<!-- Content Layout -->
<div id="productsSection" class="max-w-[1920px] mx-auto px-6 md:px-8 py-16 md:py-20 flex flex-col lg:flex-row gap-8 lg:gap-12">

    <!-- Left Side: Product Grid -->
    <div class="flex-grow order-2 lg:order-1 min-w-0">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 md:mb-12">
            <div>
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-primary font-headline">The Collection</h2>
                <p class="text-on-surface-variant mt-2 text-sm" id="resultsCount">Loading products...</p>
            </div>
            <div class="flex items-center gap-4 text-sm font-medium text-on-surface-variant">
                <span>Sort by:</span>
                <button class="flex items-center gap-1 text-primary font-semibold">
                    Popularity
                    <span class="material-symbols-outlined text-sm">expand_more</span>
                </button>
            </div>
        </div>

        <!-- Products Grid -->
        <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-6 lg:gap-x-8 gap-y-12 lg:gap-y-16">
            <!-- Populated by JS -->
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="py-20 text-center">
            <div class="inline-block w-8 h-8 border-2 border-primary/20 border-t-primary rounded-full animate-spin"></div>
            <p class="text-on-surface-variant text-sm mt-3">Loading products...</p>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden py-20 text-center">
            <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">inventory_2</span>
            <h3 class="font-headline text-xl font-bold text-primary mb-2">No products found</h3>
            <p class="text-on-surface-variant text-sm">Try adjusting your filters to find what you're looking for.</p>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="flex items-center justify-center gap-2 mt-16 md:mt-24 hidden">
            <button onclick="changePage(-1)" id="prevPage" class="w-10 h-10 rounded border border-outline-variant flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
                <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <div id="pageNumbers" class="flex items-center gap-1">
                <!-- Page numbers populated by JS -->
            </div>
            <button onclick="changePage(1)" id="nextPage" class="w-10 h-10 rounded border border-outline-variant flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
                <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>
    </div>

    <!-- Right Side: Filter Sidebar with Independent Scroll -->
    <aside class="w-full lg:w-80 flex-shrink-0 order-1 lg:order-2 lg:h-[calc(100vh-8rem)] lg:sticky lg:top-24">
        <div class="bg-surface-container-low p-6 md:p-8 rounded-xl shadow-[0_12px_48px_rgba(0,11,96,0.06)] lg:h-full lg:overflow-y-auto lg:overflow-x-hidden custom-scrollbar">
            <div class="mb-8">
                <h3 class="text-primary font-bold text-xl font-headline tracking-tight">Filters</h3>
                <p class="text-on-surface-variant text-sm font-label mt-1">Refine curated selection</p>
            </div>

            <div class="space-y-8">
                <!-- Category Filter -->
                <div class="space-y-3">
                    <div class="flex items-center gap-2 text-primary">
                        <span class="material-symbols-outlined text-sm">category</span>
                        <span class="text-sm font-bold tracking-tight font-label">Category</span>
                    </div>
                    <select id="filterCategory" onchange="onCategoryFilterChange(this.value)"
                            class="w-full appearance-none bg-surface-container-lowest border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary py-3 px-4 rounded-lg text-sm text-on-surface outline-none cursor-pointer">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <!-- Brand Filter -->
                <div class="space-y-3">
                    <div class="flex items-center gap-2 text-primary">
                        <span class="material-symbols-outlined text-sm">label</span>
                        <span class="text-sm font-bold tracking-tight font-label">Brand</span>
                    </div>
                    <select id="filterBrand"
                            class="w-full appearance-none bg-surface-container-lowest border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary py-3 px-4 rounded-lg text-sm text-on-surface outline-none cursor-pointer">
                        <option value="">All Brands</option>
                    </select>
                </div>

                <!-- Price Range -->
                <div class="space-y-3">
                    <div class="flex items-center gap-2 text-primary">
                        <span class="material-symbols-outlined text-sm">payments</span>
                        <span class="text-sm font-bold tracking-tight font-label">Price Range</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="number" id="minPrice" placeholder="Min"
                               class="w-full bg-surface-container-lowest border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg px-3 py-2.5 text-sm outline-none text-on-surface placeholder:text-outline" />
                        <span class="text-outline">-</span>
                        <input type="number" id="maxPrice" placeholder="Max"
                               class="w-full bg-surface-container-lowest border-0 ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary rounded-lg px-3 py-2.5 text-sm outline-none text-on-surface placeholder:text-outline" />
                    </div>
                </div>

                <!-- Dynamic Attribute Filters -->
                <div id="dynamicFilters" class="space-y-6 hidden">
                    <!-- Populated based on selected category -->
                </div>

                <!-- Action Buttons -->
                <div class="space-y-3 pt-4 pb-2">
                    <button onclick="applyFilters()" class="w-full py-3.5 primary-gradient text-on-primary font-bold rounded-lg hover:opacity-90 transition-all shadow-lg">
                        Apply Filters
                    </button>
                    <button onclick="clearFilters()" class="w-full text-sm font-bold text-outline hover:text-primary transition-colors">
                        Clear All
                    </button>
                </div>
            </div>
        </div>
    </aside>
</div>

@section Styles {
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background-color: rgba(0, 11, 96, 0.15);
            border-radius: 20px;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background-color: rgba(0, 11, 96, 0.3);
            }

        .custom-scrollbar {
            scrollbar-width: thin;
            scrollbar-color: rgba(0, 11, 96, 0.15) transparent;
        }

        .page-btn.active {
            background-color: #000b60;
            color: white;
        }
    </style>
}

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let totalItems = 0;
        let pageSize = 12;
        let currentFilters = {};
        let categoryAttributes = [];
        let selectedFilterValues = {};
        let hasMultiplePages = false;

        document.addEventListener('DOMContentLoaded', async () => {
            await loadCategories();
            await loadProducts();
        });

        async function loadCategories() {
            try {
                const categories = await ApiService.getCategories();
                const select = document.getElementById('filterCategory');
                categories.forEach(cat => {
                    const option = document.createElement('option');
                    option.value = cat.id;
                    option.textContent = cat.name;
                    select.appendChild(option);
                });
            } catch (e) {
                console.error('Failed to load categories:', e);
            }
        }

        async function loadBrands(categoryId = null) {
            try {
                const brands = await ApiService.getBrands(categoryId);
                const select = document.getElementById('filterBrand');
                const currentValue = select.value;
                select.innerHTML = '<option value="">All Brands</option>';
                brands.forEach(brand => {
                    const option = document.createElement('option');
                    option.value = brand.id;
                    option.textContent = brand.name;
                    select.appendChild(option);
                });
                if (currentValue && Array.from(select.options).some(o => o.value === currentValue)) {
                    select.value = currentValue;
                }
            } catch (e) {
                console.error('Failed to load brands:', e);
            }
        }

        async function onCategoryFilterChange(categoryId) {
            const dynamicSection = document.getElementById('dynamicFilters');
            await loadBrands(categoryId || null);
            if (!categoryId) {
                dynamicSection.classList.add('hidden');
                selectedFilterValues = {};
                return;
            }
            try {
                const data = await ApiService.getFiltersByCategory(categoryId);
                categoryAttributes = data.filters || [];
                selectedFilterValues = {};
                if (categoryAttributes.length === 0) {
                    dynamicSection.classList.add('hidden');
                    return;
                }
                dynamicSection.innerHTML = '';
                categoryAttributes.forEach(attr => {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'space-y-3';
                    const header = document.createElement('div');
                    header.className = 'flex items-center gap-2 text-primary';
                    header.innerHTML = `<span class="material-symbols-outlined text-sm">tune</span><span class="text-sm font-bold tracking-tight font-label">${attr.attributeName}</span>`;
                    const chipsContainer = document.createElement('div');
                    chipsContainer.className = 'flex flex-wrap gap-2';
                    chipsContainer.id = `filter-chips-${attr.attributeId}`;
                    attr.values.forEach(val => {
                        const chip = document.createElement('button');
                        chip.type = 'button';
                        chip.className = 'px-3 py-1.5 rounded-full text-xs font-medium border transition-all duration-200 bg-surface-container-lowest border-outline-variant/30 text-on-surface-variant hover:border-primary hover:text-primary';
                        chip.textContent = val.value;
                        chip.dataset.valueId = val.id;
                        chip.dataset.attributeId = attr.attributeId;
                        chip.onclick = () => toggleFilterValue(attr.attributeId, val.id, chip);
                        chipsContainer.appendChild(chip);
                    });
                    wrapper.appendChild(header);
                    wrapper.appendChild(chipsContainer);
                    dynamicSection.appendChild(wrapper);
                });
                dynamicSection.classList.remove('hidden');
            } catch (e) {
                console.error('Failed to load filters:', e);
                dynamicSection.classList.add('hidden');
            }
        }

        function toggleFilterValue(attributeId, valueId, chipElement) {
            if (!selectedFilterValues[attributeId]) selectedFilterValues[attributeId] = [];
            const values = selectedFilterValues[attributeId];
            const index = values.indexOf(valueId);
            if (index > -1) {
                values.splice(index, 1);
                chipElement.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
                chipElement.classList.add('bg-surface-container-lowest', 'text-on-surface-variant', 'border-outline-variant/30');
            } else {
                values.push(valueId);
                chipElement.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant', 'border-outline-variant/30');
                chipElement.classList.add('bg-primary', 'text-on-primary', 'border-primary');
            }
        }

        function scrollToProducts() {
            document.getElementById('productsSection').scrollIntoView({ behavior: 'smooth' });
        }

        async function loadProducts() {
            const grid = document.getElementById('productsGrid');
            const loading = document.getElementById('loadingState');
            const empty = document.getElementById('emptyState');
            const pagination = document.getElementById('pagination');
            grid.innerHTML = '';
            grid.classList.add('hidden');
            loading.classList.remove('hidden');
            empty.classList.add('hidden');
            pagination.classList.add('hidden');
            try {
                const filters = { ...currentFilters, page: currentPage };
                const response = await ApiService.getProducts(filters);
                loading.classList.add('hidden');
                grid.classList.remove('hidden');
                let products = [];
                let responseTotalCount = 0;
                let responseTotalPages = 0;
                if (Array.isArray(response)) {
                    products = response;
                    totalItems = products.length;
                    totalPages = Math.ceil(totalItems / pageSize) || 1;
                } else if (response && response.items) {
                    products = response.items;
                    responseTotalCount = response.totalCount || 0;
                    responseTotalPages = response.totalPages || 0;
                    if (responseTotalCount > 0) {
                        totalItems = responseTotalCount;
                        totalPages = responseTotalPages || Math.ceil(totalItems / pageSize) || 1;
                    } else if (responseTotalPages > 0) {
                        totalPages = responseTotalPages;
                        totalItems = responseTotalCount || (products.length + (currentPage - 1) * pageSize);
                    } else {
                        totalItems = products.length;
                        totalPages = Math.ceil(totalItems / pageSize) || 1;
                    }
                } else if (response && response.data) {
                    products = response.data;
                    responseTotalCount = response.total || 0;
                    responseTotalPages = response.totalPages || 0;
                    if (responseTotalCount > 0) {
                        totalItems = responseTotalCount;
                        totalPages = responseTotalPages || Math.ceil(totalItems / pageSize) || 1;
                    } else if (responseTotalPages > 0) {
                        totalPages = responseTotalPages;
                        totalItems = responseTotalCount || (products.length + (currentPage - 1) * pageSize);
                    } else {
                        totalItems = products.length;
                        totalPages = Math.ceil(totalItems / pageSize) || 1;
                    }
                } else {
                    products = [];
                    totalItems = 0;
                    totalPages = 1;
                }
                if (totalPages > 1) hasMultiplePages = true;
                if (!products || products.length === 0) {
                    empty.classList.remove('hidden');
                    document.getElementById('resultsCount').textContent = 'No products found';
                    updatePagination();
                    return;
                }
                const startItem = ((currentPage - 1) * pageSize) + 1;
                const endItem = Math.min(startItem + products.length - 1, totalItems);
                document.getElementById('resultsCount').textContent = totalItems > pageSize ? `Showing ${startItem}-${endItem} of ${totalItems} exclusive items` : `Showing ${products.length} exclusive items`;
                products.forEach(product => {
                    const card = createProductCard(product);
                    grid.appendChild(card);
                });
                updatePagination();
            } catch (error) {
                loading.classList.add('hidden');
                grid.classList.remove('hidden');
                showToast(error.message || 'Failed to load products');
                document.getElementById('resultsCount').textContent = 'Failed to load products';
            }
        }

        function createProductCard(product) {
            const div = document.createElement('div');
            div.className = 'group';
            div.innerHTML = `
                <a href="/Product/Details?id=${product.id}" class="block">
                    <div class="relative aspect-[3/4] bg-surface-container-low overflow-hidden mb-5 rounded-lg">
                        <img src="${product.image || 'https://via.placeholder.com/400x530?text=No+Image'}"
                             alt="${product.name}"
                             class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105"
                             onerror="this.src='https://via.placeholder.com/400x530?text=No+Image'" />
                        <div class="absolute bottom-4 left-4 right-4 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                            <button type="button" onclick="event.preventDefault(); event.stopPropagation(); addToCart(${product.id}, 1)"
                                    class="w-full bg-white/80 backdrop-blur-md p-3 rounded-lg flex justify-between items-center shadow-lg hover:bg-primary hover:text-on-primary transition-all text-primary">
                                <span class="font-bold text-sm">Add to Cart</span>
                                <span class="material-symbols-outlined">add_shopping_cart</span>
                            </button>
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <h3 class="text-lg font-bold text-primary font-headline">${product.name}</h3>
                        <div class="flex justify-between items-center">
                            <p class="text-on-surface-variant text-xs tracking-widest uppercase font-label">${product.categoryName || 'UNCATEGORIZED'}</p>
                            <span class="font-bold text-primary font-headline">$${product.price?.toFixed(2) || '0.00'}</span>
                        </div>
                        <div class="flex justify-between items-center pt-1">
                            <div class="flex items-center gap-1">
                                <div class="flex text-amber-500">
                                    ${renderStars(product.rating || 4.5)}
                                </div>
                                <span class="text-[10px] font-bold text-on-surface-variant">${product.rating || '4.5'}</span>
                            </div>
                            <span class="text-[10px] text-on-surface-variant font-medium uppercase tracking-widest font-label">${product.sold || 0} sold</span>
                        </div>
                    </div>
                </a>
            `;
            return div;
        }

        async function addToCart(productId, quantity) {
            try {
                await ApiService.addToCart(productId, quantity);
                showToast('Added to cart', 'success');
            } catch (error) {
                showToast(error.message || 'Failed to add to cart');
            }
        }

        function renderStars(rating) {
            let html = '';
            for (let i = 1; i <= 5; i++) {
                const fill = i <= Math.round(rating) ? 1 : 0;
                html += `<span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' ${fill};">star</span>`;
            }
            return html;
        }

        function updatePagination() {
            const pagination = document.getElementById('pagination');
            const prevBtn = document.getElementById('prevPage');
            const nextBtn = document.getElementById('nextPage');
            const pageNumbers = document.getElementById('pageNumbers');
            if (totalPages <= 1 && !hasMultiplePages) {
                pagination.classList.add('hidden');
                return;
            }
            pagination.classList.remove('hidden');
            prevBtn.disabled = currentPage <= 1;
            nextBtn.disabled = currentPage >= totalPages;
            pageNumbers.innerHTML = '';
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
            for (let i = startPage; i <= endPage; i++) {
                const btn = document.createElement('button');
                btn.className = `page-btn w-10 h-10 rounded font-medium transition-colors ${i === currentPage ? 'active' : 'text-on-surface-variant hover:bg-surface-container-high'}`;
                btn.textContent = i;
                btn.onclick = () => goToPage(i);
                pageNumbers.appendChild(btn);
            }
        }

        function goToPage(page) {
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            loadProducts();
            document.getElementById('productsGrid').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function changePage(direction) {
            const newPage = currentPage + direction;
            if (newPage < 1 || newPage > totalPages) return;
            goToPage(newPage);
        }

        function applyFilters() {
            currentFilters = {};
            hasMultiplePages = false;
            const categoryId = document.getElementById('filterCategory').value;
            const brandId = document.getElementById('filterBrand').value;
            const minPrice = document.getElementById('minPrice').value;
            const maxPrice = document.getElementById('maxPrice').value;
            if (categoryId) currentFilters.categoryId = categoryId;
            if (brandId) currentFilters.brandId = brandId;
            if (minPrice) currentFilters.minPrice = minPrice;
            if (maxPrice) currentFilters.maxPrice = maxPrice;
            const allValueIds = Object.values(selectedFilterValues).flat().map(id => parseInt(id));
            if (allValueIds.length > 0) currentFilters.attributeValueIds = allValueIds;
            currentPage = 1;
            loadProducts();
        }

        function clearFilters() {
            document.getElementById('filterCategory').value = '';
            document.getElementById('filterBrand').value = '';
            document.getElementById('minPrice').value = '';
            document.getElementById('maxPrice').value = '';
            loadBrands(null);
            document.querySelectorAll('[id^="filter-chips-"] button').forEach(chip => {
                chip.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
                chip.classList.add('bg-surface-container-lowest', 'text-on-surface-variant', 'border-outline-variant/30');
            });
            selectedFilterValues = {};
            document.getElementById('dynamicFilters').classList.add('hidden');
            currentFilters = {};
            currentPage = 1;
            totalPages = 1;
            hasMultiplePages = false;
            loadProducts();
        }
    </script>
}